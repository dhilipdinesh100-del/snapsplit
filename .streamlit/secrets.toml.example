# ==============================================================================
# SnapSplit — Streamlit Secrets Configuration Template
# ==============================================================================
# ⚠️ SECURITY WARNING:
# NEVER commit the real .streamlit/secrets.toml file to GitHub or public repositories.
# This template (.example) is safe for version control because it contains only placeholders.
#
# LOCAL SETUP:
# 1. Duplicate or rename this file to ".streamlit/secrets.toml".
# 2. Replace the placeholder values below with your actual credentials.
#
# STREAMLIT COMMUNITY CLOUD:
# - Paste these key-value pairs into the "Secrets" settings in the Streamlit Cloud dashboard.
# ==============================================================================

# Google Gemini API Key
# Obtain free from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY = "AQ.Ab8RN6InjYrQ8nALaDxntCBH6DBJRr7n1GifQTUGEvoqFXOhJg"

# Gmail Account for sending email summaries
GMAIL_ADDRESS = "your-gmail-address@gmail.com"

# Gmail App Password (16 characters, generated from Google Account -> Security -> App Passwords)
# NOTE: Do NOT use your regular personal Gmail password!
GMAIL_APP_PASSWORD = "your-gmail-app-password"
